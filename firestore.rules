rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Task Security
    match /tasks/{taskId} {
      allow read, write: if true;
    }

    // Settings Security
    match /settings/{userId} {
      function isValidSettings(data) {
        return data.userId == request.auth.uid
          && data.urgentLimit is number
          && data.archiveThresholdDays is number
          && data.warningThreshold is number
          && data.criticalThreshold is number
          && data.isLocalBackupEnabled is bool
          && data.localBackupPath is string && data.localBackupPath.size() <= 200;
      }

      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidSettings(request.resource.data);
      allow delete: if isOwner(userId);
    }
  }
}
