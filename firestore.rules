rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Task Security
    match /tasks/{taskId} {
      function isValidTask(data) {
        return data.userId == request.auth.uid 
          && data.title is string && data.title.size() <= 500
          && data.project is string && data.project.size() <= 100
          && data.category in ['Urgent', 'Focus', 'Archive', 'Trash']
          && data.createdAt is number
          && data.updatedAt is number
          && data.isDone is bool
          && (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000))
          && (!('deadline' in data) || (data.deadline is number || data.deadline == null))
          && (!('section' in data) || (data.section is string))
          && (!('urls' in data) || (data.urls is list))
          && (!('isStarred' in data) || (data.isStarred is bool))
          && (!('isPinned' in data) || (data.isPinned is bool))
          && (!('isAllDay' in data) || (data.isAllDay is bool));
      }

      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && isValidTask(request.resource.data)
        && request.resource.data.userId == request.auth.uid;
        
      allow update: if isSignedIn() 
        && resource.data.userId == request.auth.uid
        && isValidTask(request.resource.data)
        && request.resource.data.userId == resource.data.userId;
        
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Settings Security
    match /settings/{userId} {
      function isValidSettings(data) {
        return data.userId == request.auth.uid
          && data.urgentLimit is number
          && data.deadlineThreshold is number
          && data.archiveThresholdDays is number
          && data.doneToTrashThresholdDays is number
          && data.trashCleanupThresholdDays is number
          && data.criticalThreshold is number
          && data.isLocalBackupEnabled is bool
          && data.localBackupPath is string
          && (data.get('displayMode', 'standard') in ['compact', 'standard', 'large'])
          && (data.get('displayModeFocus', 'standard') in ['compact', 'standard', 'large'])
          && (data.get('displayModeTodo', 'standard') in ['compact', 'standard', 'large'])
          && (data.get('language', 'en') in ['en', 'ja', 'fr'])
          && (data.get('sections', ['General']) is list);
      }

      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidSettings(request.resource.data);
      allow delete: if isOwner(userId);
    }
  }
}
